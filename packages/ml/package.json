{
  "name": "@rullino/ml",
  "version": "0.1.0",
  "description": "Optional ML tools for rullino (select, remove, depth). ONNX Runtime is passed in by the caller.",
  "keywords": [
    "webgpu",
    "image-processing",
    "typescript",
    "onnx",
    "onnxruntime",
    "segmentation",
    "inpainting",
    "depth-estimation",
    "object-removal",
    "sam"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stocastico/rullino.git",
    "directory": "packages/ml"
  },
  "homepage": "https://stefanomasneri.com/rullino/",
  "bugs": {
    "url": "https://github.com/Stocastico/rullino/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "dependencies": {
    "@rullino/core": "workspace:*"
  },
  "peerDependencies": {
    "onnxruntime-web": ">=1.30.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-web": {
      "optional": true
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/fix-imports.mjs dist && cp ../../LICENSE LICENSE",
    "prepublishOnly": "node ../../scripts/refuse-publish.mjs"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
