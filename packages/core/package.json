{
  "name": "@rullino/core",
  "version": "0.1.0-rc.1",
  "description": "Zero-dependency WebGPU image-processing core: filter schema, chains, masks, geometry, LUTs, export.",
  "keywords": [
    "webgpu",
    "image-processing",
    "image",
    "filters",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stocastico/rullino.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Stocastico/rullino#readme",
  "bugs": {
    "url": "https://github.com/Stocastico/rullino/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/fix-imports.mjs dist && cp ../../LICENSE LICENSE",
    "prepublishOnly": "node ../../scripts/refuse-publish.mjs"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "peerDependencies": {
    "@webgpu/types": ">=0.1.40"
  },
  "peerDependenciesMeta": {
    "@webgpu/types": {
      "optional": true
    }
  }
}
