{
  "name": "rullino-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && node scripts/check-readmes.mjs",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run --project unit --project browser",
    "test:coverage": "vitest run --project unit --project browser --coverage",
    "dev": "pnpm --filter @rullino/playground dev",
    "test:e2e": "pnpm --filter @rullino/playground smoke",
    "test:ml": "node scripts/fetch-models.mjs && vitest run --project ml",
    "test:e2e:ml": "node scripts/fetch-models.mjs && pnpm --filter @rullino/playground smoke:ml",
    "bench": "vitest run --project bench && node scripts/fs.mjs cat packages/filters/bench/results.txt",
    "bench:cpu": "node scripts/bench-cpu.mjs",
    "bench:web": "pnpm --filter @rullino/bench bench",
    "test:pack": "node scripts/pack-smoke.mjs",
    "size": "node scripts/size-budget.mjs",
    "test:e2e:base": "pnpm --filter @rullino/playground smoke:base",
    "build:docs": "pnpm --filter @rullino/docs docs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@webgpu/types": "0.1.74",
    "ajv": "^8.20.0",
    "onnxruntime-web": "1.30.0",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
