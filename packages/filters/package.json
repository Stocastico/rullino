{
  "name": "@rullino/filters",
  "version": "0.1.0",
  "description": "WebGPU image filters with CPU reference implementations: adjustments, convolutions, edges, morphology, stylize, lens blur.",
  "keywords": [
    "webgpu",
    "wgsl",
    "image-processing",
    "image-filters",
    "photo-editing",
    "gpu",
    "typescript",
    "convolution",
    "canny",
    "clahe",
    "halftone",
    "dither",
    "lens-blur",
    "kuwahara",
    "bloom",
    "edge-detection"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stocastico/rullino.git",
    "directory": "packages/filters"
  },
  "homepage": "https://stefanomasneri.com/rullino/",
  "bugs": {
    "url": "https://github.com/Stocastico/rullino/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@rullino/core": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/fix-imports.mjs dist && cp ../../LICENSE LICENSE",
    "prepublishOnly": "node ../../scripts/refuse-publish.mjs"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
