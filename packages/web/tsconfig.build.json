{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "types": [
      "@webgpu/types"
    ],
    "paths": {
      "@rullino/core": [
        "../core/dist/index.d.ts"
      ],
      "@rullino/core/internal": [
        "../core/dist/internal.d.ts"
      ],
      "@rullino/filters": [
        "../filters/dist/index.d.ts"
      ],
      "@rullino/presets": [
        "../presets/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
