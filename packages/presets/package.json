{
  "name": "@rullino/presets",
  "version": "0.1.0-rc.1",
  "description": "Photo looks for rullino: LUT recipes plus vignette and grain.",
  "keywords": [
    "webgpu",
    "image-processing",
    "image",
    "filters",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stocastico/rullino.git",
    "directory": "packages/presets"
  },
  "homepage": "https://github.com/Stocastico/rullino#readme",
  "bugs": {
    "url": "https://github.com/Stocastico/rullino/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@rullino/core": "workspace:*",
    "@rullino/filters": "workspace:*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/fix-imports.mjs dist && cp ../../LICENSE LICENSE",
    "prepublishOnly": "node ../../scripts/refuse-publish.mjs"
  },
  "files": [
    "dist",
    "LICENSE"
  ]
}
