{
  "name": "rullino-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run --project unit --project browser",
    "dev": "pnpm --filter @rullino/playground dev",
    "test:e2e": "pnpm --filter @rullino/playground smoke",
    "bench": "vitest run --project bench && cat packages/filters/bench/results.txt"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "@webgpu/types": "0.1.74",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
